<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 暗色模式 API 23+：状态栏图标保持白色 -->
    <style name="Theme.LiteMusic" parent="Theme.LiteMusic.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
    </style>

    <!-- 播放页暗色模式 API 23+：状态栏使用与页面完全一致的主表面色 + 白色图标 -->
    <style name="Theme.LiteMusic.Player" parent="Theme.LiteMusic.Base">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>
</resources>
